# Copy to .env (never commit .env). Every value is optional.

# Ports on 127.0.0.1 (Docker Compose). The systemd install uses 8600 (API) and 8517 (Streamlit).
OPTLAB_API_PORT=8600
OPTLAB_RESEARCH_PORT=8518

# Run the containers as your user so data/ keeps your ownership (see `id -u` and `id -g`).
OPTLAB_UID=1000
OPTLAB_GID=1000

# Base images: set these if Docker Hub rate-limits you ("429 Too Many Requests").
# OPTLAB_PYTHON_IMAGE=mirror.gcr.io/library/python:3.13-slim-bookworm
# OPTLAB_NODE_IMAGE=mirror.gcr.io/library/node:22-bookworm-slim

# Link shown in the dashboard's sidebar for the Research Lab (default: same host, port 8517 / :8443 on HTTPS).
# OPTLAB_RESEARCH_URL=http://127.0.0.1:8518/

# Quote source for the API: live (Cboe through OpenBB, ~15 min delayed) or synthetic (offline demo).
# Default: follows config.yaml data.source.
# OPTLAB_QUOTE_SOURCE=live

# Database location (default: data/optlab.sqlite in the project).
# OPTLAB_DB_URL=sqlite:////absolute/path/optlab.sqlite

# Extra allowed browser origins for the API (comma-separated, never "*").
# OPTLAB_CORS_ORIGINS=http://127.0.0.1:8600,http://localhost:8600

# Provider credentials for later phases go here too (never in config.yaml or source code).
